# --- secrets -----------------------------------------------------------------
.env
.env.local
*.key

# --- python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ruff_cache/

# --- app data ----------------------------------------------------------------
# The HTTP response cache is regenerated on demand. The *seeded* cache that
# ships with the repo is force-added (see README) so a fresh clone works offline.
data/cache/*.json
data/cache/*.sqlite-journal

# --- os / editor -------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/

# Measurement outputs are regenerated by scripts/ and committed deliberately
# when they back a claim in the report. Logs are not.
data/*.log

# Intermediate recording; the committed deliverable is demo.mp4 (H.264).
report/demo/*.webm

# Ready-to-upload bundle; everything in it is derived from report/dist.
SUBMIT/
