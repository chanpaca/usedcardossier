# ---------------------------------------------------------------------------
# UsedCarDossier — environment template
#
#   cp .env.example .env     then fill in ONE of the keys below.
#
# The app searches for .env in TWO places, in this order:
#   1. the repo folder          ./.env
#   2. the parent folder        ../.env
# The first file found wins. The real .env is gitignored and never committed.
# ---------------------------------------------------------------------------

# --- LLM access (required — set exactly one of these) ----------------------

# Option A: the course Portkey gateway. The only permitted model is gpt-6-luna.
PORTKEY_API_KEY=your_key_here
PORTKEY_MODEL=gpt-6-luna
# PORTKEY_BASE_URL=https://api.portkey.ai/v1      # optional override
# PORTKEY_VIRTUAL_KEY=your_virtual_key_here       # optional

# Option B: a personal OpenAI key. Used only if PORTKEY_API_KEY is unset.
# OPENAI_API_KEY=your_key_here
# OPENAI_MODEL=gpt-4o-mini


# --- Vehicle data (no key required) ----------------------------------------
# fueleconomy.gov and the NHTSA APIs are free, keyless, and US-only.
# These are listed only so you can point the app at a mirror if one is down.
# FUELECONOMY_BASE_URL=https://www.fueleconomy.gov/ws/rest
# NHTSA_BASE_URL=https://api.nhtsa.gov


# --- Optional: live listing prices -----------------------------------------
# The app ships with a dated price snapshot and works fully without this.
# Supplying a key enables live listing lookups as an enhancement only.
# AUTODEV_API_KEY=your_key_here


# --- Server (optional) ------------------------------------------------------
# HOST=127.0.0.1
# PORT=8000
